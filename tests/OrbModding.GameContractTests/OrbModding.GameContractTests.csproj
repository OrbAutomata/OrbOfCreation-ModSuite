<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>OrbModding.GameContractTests</AssemblyName>
    <RequireGameReferences>false</RequireGameReferences>
    <UseGameStubs Condition="'$(GameRoot)' == '' and '$(UseGameStubs)' == ''">true</UseGameStubs>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OrbModSuite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../data/native-contracts.json" Link="data/native-contracts.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
