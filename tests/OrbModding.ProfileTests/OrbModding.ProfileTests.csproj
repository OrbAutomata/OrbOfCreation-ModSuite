<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>OrbModding.ProfileTests</AssemblyName>
    <RequireGameReferences>false</RequireGameReferences>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OrbModding.GameStubs/OrbModding.GameStubs.csproj"
                      AdditionalProperties="EnableServiceCycleProfiler=true;UseGameStubs=true" />
    <ProjectReference Include="../../src/OrbModSuite.csproj"
                      AdditionalProperties="EnableServiceCycleProfiler=true;UseGameStubs=true" />
    <ProjectReference Include="../../tools/OrbModding.ServiceCycleTrace/OrbModding.ServiceCycleTrace.csproj"
                      AdditionalProperties="EnableServiceCycleProfiler=true;UseGameStubs=true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../TestSupport/**/*.cs" Link="TestSupport/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../data/entity-mappings.tsv" Link="data/entity-mappings.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/entity-display-names.tsv" Link="data/entity-display-names.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
