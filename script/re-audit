#!/usr/bin/env bash
# Re-audit an Orb of Creation build after the game updates.
#
# The suite computes the game's economy math itself, transcribed from one specific assembly pair,
# so gameplay runtime starts quarantined on a build it has not audited (see SuiteLoadGate). The
# quarantined Mods verifier is how a new build becomes trusted; the Advanced override is player
# consent, not audit evidence and never makes --stamp automatic.
#
# It never stamps a baseline it has not verified. Each stage must pass before the next runs, and
# the final stamp only happens if every stage passed, because a baseline written on the strength of
# a hash alone would assert that the ported math is still correct without having checked it.
#
# Usage:
#   script/re-audit --game-dir /path/to/game            # verify only, report what changed
#   script/re-audit --game-dir /path/to/game --stamp    # verify, then print the admission checklist
#
# Compilation stages also require BepInEx/core under the game root passed to --game-dir.
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
game_dir=""
stamp=0

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --game-dir)
            game_dir="${2:-}"
            shift 2
            ;;
        --stamp)
            stamp=1
            shift
            ;;
        -h|--help)
            grep '^#' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

if [[ -z "${game_dir}" ]]; then
    echo "Usage: script/re-audit --game-dir <path to game install> [--stamp]" >&2
    exit 2
fi

if [[ ! -d "${game_dir}" ]]; then
    echo "Game directory not found: ${game_dir}" >&2
    exit 2
fi

find_managed() {
    local root="$1"
    local candidate
    for candidate in \
        "${root}/Orb Of Creation_Data/Managed" \
        "${root}/Contents/Resources/Data/Managed" \
        "${root}/Orb Of Creation.app/Contents/Resources/Data/Managed"; do
        if [[ -f "${candidate}/Assembly-CSharp.dll" && -f "${candidate}/Assembly-CSharp-firstpass.dll" ]]; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    return 1
}

managed=""
if ! managed="$(find_managed "${game_dir}")"; then
    echo "FAIL: no managed assembly directory containing both game assemblies under ${game_dir}" >&2
    exit 1
fi

sha_of() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print toupper($1)}'
    else
        sha256sum "$1" | awk '{print toupper($1)}'
    fi
}

main_sha="$(sha_of "${managed}/Assembly-CSharp.dll")"
firstpass_sha="$(sha_of "${managed}/Assembly-CSharp-firstpass.dll")"

echo "Managed directory : ${managed}"
echo "Assembly-CSharp   : ${main_sha}"
echo "…-firstpass       : ${firstpass_sha}"
echo

audit_source="${repository_root}/src/Common/GameAssemblyAudit.cs"
# A missing file makes both greps fail, which reads exactly like an unknown build: the script
# would re-audit a baseline it already has. Fail on the path instead of on its contents.
if [[ ! -f "${audit_source}" ]]; then
    echo "Baseline source not found: ${audit_source}" >&2
    exit 1
fi
if grep -qi "${main_sha}" "${audit_source}" && grep -qi "${firstpass_sha}" "${audit_source}"; then
    echo "Stage 1 hashes            : already an audited baseline; nothing to re-audit."
    exit 0
fi
echo "Stage 1 hashes            : NEW BUILD (not a known baseline)"

# Stage 2. The suite must still compile against the new assemblies. This catches removed or
# reshaped members that the reflection contracts and the ported math depend on.
echo -n "Stage 2 compiles          : "
if OOC_GAME_DIR="${game_dir}" dotnet build "${repository_root}/src/OrbModSuite.csproj" \
        -p:RequireGameReferences=true -p:UseGameStubs=false -c Debug --disable-build-servers \
        >/tmp/orb-re-audit-build.log 2>&1; then
    echo "ok"
else
    echo "FAIL"
    echo "  The suite no longer compiles against this build. See /tmp/orb-re-audit-build.log" >&2
    exit 1
fi

# Stage 3. Native contracts and every other portable check.
echo -n "Stage 3 contracts + tests : "
if "${repository_root}/script/test" >/tmp/orb-re-audit-test.log 2>&1; then
    echo "ok"
else
    echo "FAIL"
    echo "  Portable gate failed against this build. See /tmp/orb-re-audit-test.log" >&2
    exit 1
fi

# Stage 4. Every declared native contract, read out of the assemblies this build actually ships.
# Stage 3 runs against stubs the suite writes itself, so it can only prove the suite is consistent
# with its own idea of the game; nothing before this point opens the new binaries at all.
#
# The baseline-identity test is excluded here and only here. Stage 1 already established that this
# build is not a known baseline, so asserting it again would fail this stage for the single reason
# a re-audit is being run. Everything else in the project must pass.
contract_project="${repository_root}/tests/OrbModding.GameContractTests/OrbModding.GameContractTests.csproj"
if [[ ! -f "${contract_project}" ]]; then
    echo "Installed-game contract project not found: ${contract_project}" >&2
    exit 1
fi
echo -n "Stage 4 native contracts  : "
if OOC_GAME_DIR="${game_dir}" dotnet test "${contract_project}" \
        --configuration Debug --disable-build-servers \
        --filter "FullyQualifiedName!~InstalledGame_IsAnAuditedBaseline" \
        >/tmp/orb-re-audit-contracts.log 2>&1; then
    echo "ok"
else
    echo "FAIL"
    echo "  A declared native contract no longer matches this build's assemblies." >&2
    echo "  See /tmp/orb-re-audit-contracts.log" >&2
    exit 1
fi

# Stage 5. The differential cost check. This is the one that cannot be automated here: it needs the
# game running, because the game is the only oracle for its own economy math. Compiling and passing
# tests proves the members still exist, NOT that they still mean the same thing — a changed formula
# would sail through stages 2 to 4 untouched.
cat <<'PENDING'
Stage 5 differential math : MANUAL

  Launch the game with this build. The quarantined control plane loads without
  installing gameplay patches or services; use Mods -> Runtime to run the
  differential verifier.
  It compares every cost the suite computes against the game's own result and
  reports pass or fail.

  Stages 2 to 4 prove the members still exist. Only stage 5 proves they still
  compute what the ported math assumes, so a baseline must not be stamped
  without it.
PENDING

if [[ "${stamp}" -eq 0 ]]; then
    echo
    echo "Verification finished. Re-run with --stamp once stage 5 has passed in game."
    exit 0
fi

cat <<EOF

Ready to stamp a new baseline. This is the whole admission checklist. Step 1 is what admits the
build at runtime; the others keep the quarantine message, Auto Scribe and the manifest in step with
it. Pick a baseline id such as steam-<platform>-<install date>.

1. ${audit_source#"${repository_root}/"}:
   - a <Name>BaselineId constant holding the id;
   - <Name>AssemblyCSharpSha256 = "${main_sha}"
     and <Name>FirstPassSha256  = "${firstpass_sha}";
   - a <Name>SteamBaseline property built from those three constants;
   - a branch for that property in MatchBaseline, which admits only the baselines it names.

2. src/Common/SuiteLoadGate.cs: add the id to the audited baselines DescribeQuarantine lists.

3. src/AutoScribe/Identity/AutoScribeIdentityProfile.cs: give the id a profile in
   TryGetProfile, or Auto Scribe stays unavailable on this build.

4. data/native-contracts.json, a new entry in "baselines" for the complete pair:
   id (the same id), platform, auditedAt, gameBuild, provenance, and an "assemblies" array with
   one entry each for "assembly-csharp" (sha256 ${main_sha}) and
   "assembly-csharp-firstpass" (sha256 ${firstpass_sha}), each with its provenance path
   relative to the game root: ${managed#"${game_dir%/}/"}/<file>.dll

5. tests/OrbModding.GameContractTests/NativeContractManifestTests.cs:
   RuntimeHashGuards_MatchEveryManifestBaselinePair counts the baselines and asserts each one;
   raise the count and add the new property.

6. Run the whole contract project against this build, with nothing filtered out:

   OOC_GAME_DIR="${game_dir}" dotnet test tests/OrbModding.GameContractTests

   Stage 4 skipped the baseline-identity test because no baseline existed yet; now it must pass.
   A run that still reports an unknown assembly pair means the stamp does not describe the build
   it was taken from.

Stamping is deliberately not automatic: it asserts a human confirmed stage 5 in game.
EOF
